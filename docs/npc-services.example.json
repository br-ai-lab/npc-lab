{
  "services": [
    {
      "name": "backend",
      "cwd": "backend",
      "command": "mvn -q spring-boot:run",
      "health": "http://localhost:8080/health",
      "healthTimeoutSeconds": 180
    },
    {
      "name": "frontend",
      "cwd": "frontend",
      "command": "npm run dev -- --host 127.0.0.1",
      "health": "http://127.0.0.1:5173",
      "healthTimeoutSeconds": 120
    }
  ]
}
